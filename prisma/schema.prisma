generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  translateRecipes Boolean @default(true)
  themePreference  String  @default("system") // "light", "dark", or "system"

  accounts      Account[]
  sessions      Session[]
  recipes       Recipe[]
  sharedRecipes Recipe[]       @relation("RecipeSharedBy")
  notifications Notification[]
  sentShares    Notification[] @relation("NotificationSender")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models
model Recipe {
  id          String   @id @default(cuid())
  title       String
  description String?
  sourceUrl   String?
  imagePath   String?
  ingredients String   // JSON string array
  steps       String   // JSON string array
  rawContent  String?  // Original scraped content for reference
  isFavorite        Boolean   @default(false)
  cookThisWeekUntil DateTime? // Non-null = marked "to cook this week"; null = not marked
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sourceLanguage        String?  // Detected language (e.g. "es", "fr", "en")
  isTranslatedToEnglish Boolean  @default(false)

  // Sharing provenance
  sharedByUserId    String?  // User who sent this recipe (if it was shared)
  sharedFromRecipeId String? // Original recipe id this was copied from
  sharedBy           User?   @relation("RecipeSharedBy", fields: [sharedByUserId], references: [id], onDelete: SetNull)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags RecipeTag[]

  @@index([userId])
  @@index([title])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  recipes RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@index([tagId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // e.g. "recipe_shared"
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Recipient
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sender
  senderUserId String?
  sender       User?   @relation("NotificationSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  // Associated recipe (the copied recipe on the recipient's account)
  recipeId String?

  @@index([userId])
  @@index([userId, isRead])
}
