    "express": "^4.21.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.59.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.4"
  }
}
