    "@prisma/client": "^7.7.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.1",
    "next": "16.2.3",
    "next-auth": "^5.0.0-beta.30",
    "pino": "^10.3.1",
    "playwright-core": "^1.59.1",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
