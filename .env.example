# ─── Authentication ───
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID (Azure AD) OAuth — https://entra.microsoft.com/
# Callback URL: <APP_URL>/api/auth/callback/microsoft-entra-id
# Leave empty to disable Microsoft login.
MICROSOFT_ENTRA_ID_CLIENT_ID=""
MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
# Issuer controls which Microsoft accounts are allowed:
#   common    = personal (MSN/Outlook/Hotmail) + work/school accounts (default)
#   consumers = personal accounts only
#   organizations = work/school accounts only
#   <tenant-id> = single-tenant (your organisation only)
MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# ─── Gemini AI ───
GEMINI_API_KEY=""
# Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL="gemini-2.0-flash"
# Gemini model used for the in-recipe chat assistant (default: gemini-flash-lite-latest) — deliberately a cheaper/faster model since chat is called far more often than extraction/translation
GEMINI_CHAT_MODEL="gemini-flash-lite-latest"

# ─── Database ───
DATABASE_URL="file:./dev.db"

# ─── Registration ───
# Comma-separated list of email addresses allowed to register.
# Existing users can always sign in regardless of this setting.
# Leave empty or remove to allow anyone to register (open registration).
ALLOWED_EMAILS=""

# ─── Admin ───
# Comma-separated list of email addresses with access to the /admin page.
# Defaults to "aresiusxp@gmail.com" when unset.
# This is separate from ALLOWED_EMAILS (which controls registration).
ADMIN_EMAILS="aresiusxp@gmail.com"

# ─── Application ───
# Base URL used for OAuth callbacks and absolute links
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 equivalent of NEXTAUTH_URL (set to the same value in production)
AUTH_URL="http://localhost:3000"

# Directory where recipe images are stored (relative to project root)
MEDIA_DIR="public/media"

# ─── Service versions (Admin page) ───
# The backend surfaces the deployed image tag of each service on the /admin page.
# In Kubernetes these are injected automatically by the Helm chart from the image
# tags in values.yaml (see helm/recipes/templates/backend-deployment.yaml), so you
# normally do NOT set them by hand. They default to "unknown" when unset (e.g. in
# local development). Set them only if you want the Admin page to show a version locally.
APP_VERSION_BACKEND=""
APP_VERSION_FRONTEND=""
APP_VERSION_SCRAPER=""
